{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],

			"@/assets/*": ["./assets/*"],

			"@/components/*": ["./src/components/*"],

			"@/theme": ["./src/theme/index.ts"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
